  airline      String?

  passengerName String?
  route         String?

  issueDate     DateTime?
  departureDate DateTime?

  supplierCost Decimal? @db.Decimal(14, 2)
  sellingPrice Decimal? @db.Decimal(14, 2)
  tax          Decimal? @db.Decimal(14, 2)
  markup       Decimal? @db.Decimal(14, 2)
  profit       Decimal? @db.Decimal(14, 2)

  status TicketRequestStatus @default(CONFIRMED)

  refundAmount  Decimal? @db.Decimal(14, 2)
  reissueAmount Decimal? @db.Decimal(14, 2)

